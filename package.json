{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node -e \"const fs=require('fs');if(fs.existsSync('public/hot'))fs.unlinkSync('public/hot')\" && vite build",
        "build:pages": "vite build --config vite.config.pages.js && node -e \"const fs=require('fs');if(fs.existsSync('docs/template.html')){fs.copyFileSync('docs/template.html','docs/index.html');fs.unlinkSync('docs/template.html');}fs.writeFileSync('docs/.nojekyll','');\"",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^5.2.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "lightningcss-win32-x64-msvc": "^1.33.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@xyflow/react": "^12.12.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    }
}
